# Core mode
DJANGO_ENV=production
DJANGO_PRODUCTION=True
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret

# Hosts and CSRF
DJANGO_ALLOWED_HOSTS=ggenre.com,www.ggenre.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ggenre.com,https://www.ggenre.com

# Database (MySQL)
DB_ENGINE=django.db.backends.mysql
MYSQL_DATABASE=ggenre
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Security
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_COOKIE_AGE=31536000
SESSION_SAVE_EVERY_REQUEST=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Auth throttling
AUTH_THROTTLE_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_LOGIN_MAX_ATTEMPTS=10

# Email (SMTP)
LOCAL_CONSOLE_EMAIL=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=your_sender@example.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=your_sender@example.com
SERVER_EMAIL=your_sender@example.com

# Optional channels/redis
REDIS_URL=redis://127.0.0.1:6379/1

# Optional logging
DJANGO_LOG_LEVEL=INFO

# Portable Studio capacity and CPU worker settings (paths may be absolute).
# Leave the storage path unset to retain the existing studio_private folder.
# STUDIO_STORAGE_ROOT=/data/audio
# STUDIO_MODEL_ROOT=/data/models
# TMPDIR=/data/tmp
STUDIO_EXTRACTION_DEVICE=cpu
STUDIO_EXTRACTION_PROFILE=fast
STUDIO_EXTRACTION_THREADS=1
STUDIO_EXTRACTION_WINDOW_SECONDS=6
STUDIO_ARTIST_STORAGE_MIB=1024
STUDIO_MIN_FREE_MIB=256
STUDIO_JOB_LEASE_SECONDS=120
STUDIO_JOB_MAX_ATTEMPTS=2
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
# Light web hosts may queue these engines to a checked, shared-storage worker.
# STUDIO_REMOTE_AUDIO_ENGINES=tune,separate
